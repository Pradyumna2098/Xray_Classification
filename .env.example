# Environment Configuration
# Copy this file to .env and update with your values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Model Configuration
MODEL_NAME=vgg19  # Options: vgg19, densenet201, custom
MODEL_WEIGHTS_PATH=models/vgg19_best.weights.h5
INPUT_HEIGHT=150
INPUT_WIDTH=150

# Logging
LOG_LEVEL=INFO

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Development
DEBUG=false
RELOAD=false
